# Address reachable from inside this Docker container.
# If Youtarr runs on the same server and uses port 3087, keep this value.
YOUTARR_URL=http://host.docker.internal:3087
YOUTARR_USERNAME=your-username
YOUTARR_PASSWORD=your-password

# Server-side storage for watch progress, feed cache, and single videos.
YOUTARR_FEED_DATA_DIR=/data

# Optional: number of seconds feed/local-video results are reused as a fast
# server-side cache. The default is 300 seconds.
# YOUTARR_FEED_CACHE_TTL_SECONDS=300

# Optional but recommended: mount the same Youtarr download folder into this
# container, using the same container path Youtarr uses.
# This lets the app stream local files directly instead of proxying via Youtarr.
YOUTARR_MEDIA_DIR=/usr/src/app/data

# Optional: only needed if Youtarr stores file paths with a different container
# prefix than this app's YOUTARR_MEDIA_DIR. Example: /downloads.
# YOUTARR_SOURCE_MEDIA_DIR=/usr/src/app/data

# Optional: second Youtarr instance for codec-specific playback routing.
# Keep the main YOUTARR_URL as your feed/download owner. Add a VP9 Youtarr here
# when iPad or Mac Safari should play a VP9 copy instead of the main copy.
# If username/password/session values are omitted, the main Youtarr credentials
# are reused. If only YOUTARR_VP9_API_KEY is set, the API key is used directly.
# YOUTARR_VP9_URL=http://host.docker.internal:3088
# YOUTARR_VP9_USERNAME=
# YOUTARR_VP9_PASSWORD=
# YOUTARR_VP9_API_KEY=
# YOUTARR_VP9_SESSION_TOKEN=
# YOUTARR_VP9_AUTH_DISABLED=false
# YOUTARR_VP9_MEDIA_DIR=/usr/src/app/data-vp9
# YOUTARR_VP9_SOURCE_MEDIA_DIR=/usr/src/app/data

# Optional: explicit AV1 playback instance. Usually not needed when your main
# Youtarr instance already downloads AV1/highest-quality files.
# YOUTARR_AV1_URL=
# YOUTARR_AV1_USERNAME=
# YOUTARR_AV1_PASSWORD=
# YOUTARR_AV1_API_KEY=
# YOUTARR_AV1_SESSION_TOKEN=
# YOUTARR_AV1_AUTH_DISABLED=false
# YOUTARR_AV1_MEDIA_DIR=
# YOUTARR_AV1_SOURCE_MEDIA_DIR=/usr/src/app/data

# Optional: auto chooses VP9 for iPad/Mac Safari when YOUTARR_VP9_URL is set,
# and otherwise uses the main instance. You can force primary, av1, or vp9.
# YOUTARR_PLAYBACK_PROFILE=auto

# Optional: a separate API key for download requests.
# YOUTARR_API_KEY=

# Optional: fallback for exact YouTube publishedAt timestamps in Youtarr Feed.
# Prefer setting the YouTube API key in Youtarr itself first. This variable is
# only needed when Youtarr still returns dates without times.
# YOUTUBE_API_KEY=

# Alternatives to username/password:
# YOUTARR_SESSION_TOKEN=
# YOUTARR_AUTH_DISABLED=false

# Optional: let this app trigger a Plex library scan after a download.
# Not needed when Youtarr already does this for you.
# PLEX_URL=http://host.docker.internal:32400
# PLEX_TOKEN=
# PLEX_LIBRARY_ID=
# PLEX_WATCH_SYNC_ENABLED=true
