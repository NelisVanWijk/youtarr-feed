# Adres dat vanuit deze Docker-container bereikbaar is.
# Staat Youtarr op dezelfde server en gebruikt het poort 3087, laat dit zo.
YOUTARR_URL=http://host.docker.internal:3087
YOUTARR_USERNAME=jouw-gebruikersnaam
YOUTARR_PASSWORD=jouw-wachtwoord

# Server-side opslag voor kijkvoortgang.
YOUTARR_FEED_DATA_DIR=/data

# Optioneel: een losse API-key voor downloadopdrachten.
# YOUTARR_API_KEY=

# Alternatieven voor gebruikersnaam/wachtwoord:
# YOUTARR_SESSION_TOKEN=
# YOUTARR_AUTH_DISABLED=false

# Optioneel: laat deze app na een download ook een Plex-bibliotheekscan starten.
# Niet nodig als Youtarr dit zelf al voor je doet.
# PLEX_URL=http://host.docker.internal:32400
# PLEX_TOKEN=
# PLEX_LIBRARY_ID=
